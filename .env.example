# ========================================================
# [따뜻한 하루 일기 & AI 응원 웹앱 - 환경 변수 설정 가이드]
# ========================================================

# 1. Google Gemini API 키 (필수)
# Google AI Studio(https://aistudio.google.com/app/apikey)에서 무료로 발급받을 수 있습니다.
# 백엔드 서버(Node/Express) 환경 변수:
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. Vite 프론트엔드 직접 연동용 환경 변수 (Vercel 정적 배포 시 사용 가능):
# Vercel 등 프론트엔드 전용 호스팅 시 Vite가 빌드 타임에 주입하도록 설정할 수 있습니다.
VITE_GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. 앱 서비스 호스팅 URL (선택)
APP_URL="http://localhost:3000"

# ========================================================
# [Vercel 배포 가이드 안내]
# 1) GitHub 저장소에 코드를 push 합니다.
# 2) Vercel 대시보드(vercel.com)에서 'Add New Project' 클릭 후 저장소를 Import 합니다.
# 3) 'Environment Variables' 설정 섹션에서:
#    - Key: GEMINI_API_KEY (또는 VITE_GEMINI_API_KEY)
#    - Value: 구글 AI 스튜디오에서 발급받은 API 키 입력
# 4) Deploy 버튼을 누르면 배포 완료!
# ========================================================
